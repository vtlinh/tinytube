<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- silent self-updates on Android 12+ once this app is its own installer of record -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.YtKids"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Not exported: nothing outside the app has any business starting a
             player, and an exported one would let any installed app hand this
             screen an arbitrary video id. PlayerActivity validates the id
             anyway, but the smaller surface is the real fix. -->
        <!-- configChanges: rotating must not recreate the player, because a
             rebuild tears down the WebView and restarts the video from the
             beginning. -->
        <activity
            android:name=".PlayerActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:supportsPictureInPicture="false"
            android:theme="@style/Theme.YtKids.Player"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden" />

        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:label="@string/about_title" />

        <!-- Both are parent-facing and neither is exported: nothing outside
             the app may open parent mode, and in particular nothing may skip
             the challenge by starting ParentActivity directly. -->
        <activity
            android:name=".ChallengeActivity"
            android:exported="false"
            android:label="@string/challenge_title"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <activity
            android:name=".ParentActivity"
            android:exported="false"
            android:label="@string/parent_mode"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden" />

        <!-- Reached only from parent mode, which is itself behind the gate. -->
        <activity
            android:name=".ApprovedChannelsActivity"
            android:exported="false"
            android:label="@string/parent_approved_title" />

        <!-- So About can hand the player's last measured strip to the share
             sheet. Not exported; a receiving app gets a one-shot read grant on
             the single file, and file_paths.xml exposes nothing else. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".UpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dev.vtlinh.ytkids.INSTALL_UPDATE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".InstallReceiver"
            android:exported="false" />

    </application>

</manifest>
