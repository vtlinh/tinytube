<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- silent self-updates on Android 12+ once this app is its own installer of record -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.YtKids"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false">

        <!-- Not exported, and carrying no launcher filter of its own: the
             alias below is what the launcher sees. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <!-- The launcher entry, under the class name this activity had before
             the Kotlin package was renamed to match the app.

             A home-screen icon is a pinned COMPONENT NAME, not an app. Moving
             MainActivity from dev.vtlinh.ytkids to dev.vtlinh.tinytube would
             therefore have left every already-placed icon pointing at a class
             that no longer exists — the app still installed, still in the
             drawer, and its icon on the home screen dead. The applicationId
             never moved, so this alias is a real, resolvable name and costs
             nothing but its own four lines.

             Don't "tidy" this into .MainActivity. The old name is the point. -->
        <activity-alias
            android:name="dev.vtlinh.ytkids.MainActivity"
            android:targetActivity=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Not exported: nothing outside the app has any business starting a
             player, and an exported one would let any installed app hand this
             screen an arbitrary video id. PlayerActivity validates the id
             anyway, but the smaller surface is the real fix. -->
        <!-- configChanges: rotating must not recreate the player, because a
             rebuild tears down the WebView and restarts the video from the
             beginning. -->
        <activity
            android:name=".PlayerActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:supportsPictureInPicture="false"
            android:theme="@style/Theme.YtKids.Player"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden" />

        <!-- Both are parent-facing and neither is exported: nothing outside
             the app may open parent mode, and in particular nothing may skip
             the challenge by starting ParentActivity directly. -->
        <activity
            android:name=".ChallengeActivity"
            android:exported="false"
            android:label="@string/challenge_title"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <activity
            android:name=".ParentActivity"
            android:exported="false"
            android:label="@string/parent_mode"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden" />

        <!-- Reached only from parent mode, which is itself behind the gate. -->
        <activity
            android:name=".ApprovedChannelsActivity"
            android:exported="false"
            android:label="@string/parent_approved_title" />

        <!-- Same rule as ParentActivity: not exported, and started only by a
             RESULT_OK from ChallengeActivity. A setting a child can reach is
             not a parental control. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

        <receiver
            android:name=".UpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dev.vtlinh.ytkids.INSTALL_UPDATE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".InstallReceiver"
            android:exported="false" />

    </application>

</manifest>
