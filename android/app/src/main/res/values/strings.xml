<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The launcher label, the grid's heading, and the name on the settings
         screen, all from here.

         The applicationId and the Worker's hostname now match it, which they
         did not at first: those two are addresses rather than labels, and
         moving them meant this build cannot update the app that came before
         it. See README's Naming. -->
    <string name="app_name">TinyTube</string>

    <!-- Written to be read out loud by a parent, not by the child: an empty
         grid is a setup step nobody has done yet, not a fault. It names the
         button that fixes it, because the parent reading it is standing in
         front of that button. -->
    <string name="empty_catalog">No videos yet.\n\nA grown-up can add channels with the Parent button.</string>

    <!-- The bottom bar. Two words, both nouns a child who cannot read still
         learns by position. -->
    <string name="tab_videos">Videos</string>
    <string name="tab_channels">Channels</string>
    <string name="channels_title">Channels</string>
    <string name="channels_empty">No channels yet.\n\nA grown-up can add them with the Parent button.</string>
    <!-- Shown as the grid's heading while one channel's videos are on screen,
         so it is obvious this is not everything. -->
    <string name="showing_channel">%1$s</string>
    <string name="show_all_videos">All videos</string>

    <!-- parent mode and its gate -->
    <string name="parent_mode">Parent</string>
    <string name="kids_mode">← Kids mode</string>
    <string name="gate_title">Grown-ups only</string>
    <string name="gate_subtitle">Unlock to open parent mode</string>
    <string name="challenge_title">Grown-ups only</string>
    <string name="challenge_question">If X + Y = %1$d and X − Y = %2$d,\nwhat are X and Y?</string>
    <string name="challenge_hint_x">X</string>
    <string name="challenge_hint_y">Y</string>
    <string name="challenge_submit">Continue</string>
    <string name="challenge_wrong">Not quite — here are two new numbers.</string>

    <string name="player_back">Back</string>
    <string name="parent_add_channel">Approve this channel</string>
    <string name="parent_remove_channel">Remove this channel</string>
    <string name="parent_approved_button">Approved channels</string>
    <string name="parent_approved_title">Channel List</string>
    <string name="parent_none_approved">No channels approved yet.\n\nFind a channel and tap the + button.</string>
    <string name="parent_remove">Remove</string>
    <string name="parent_remove_named">Remove “%1$s”</string>
    <string name="parent_remove_confirm">Remove “%1$s”? Its videos will stop appearing.</string>
    <string name="parent_blocked_fmt">Blocked: %1$s is outside parent mode.</string>
    <string name="parent_resolving">Working out which channel this is…</string>
    <string name="parent_no_channel_here">Couldn\'t identify a channel on this page.</string>
    <string name="parent_approved">Approved “%1$s”</string>
    <string name="parent_removed">Removed “%1$s”</string>


    <!-- The heading over the only part of About that does anything. -->
    <string name="about_updates">Updates</string>
    <!-- The versionCode is what the updater actually compares, but it means
         nothing to a parent — the version name is the human-facing one. -->
    <string name="version_fmt">Version %1$s</string>
    <string name="author">By Linh Vu</string>

    <string name="notif_off_explain">Notifications are off, so nothing will tell you when an update is ready. Updates still download, and you can install them from this screen.</string>
    <string name="notif_blocked_explain">Notifications are turned off for this app in Android settings, so nothing will tell you when an update is ready. Updates still download, and you can install them from this screen.</string>
    <string name="notif_turn_on">Turn on notifications</string>
    <string name="notif_open_settings">Open notification settings</string>

    <string name="up_to_date">This is the latest version.</string>
    <string name="checking">Checking…</string>
    <string name="check_failed">Could not check for updates.</string>
    <string name="check_for_updates">Check for updates</string>
    <string name="downloading_fmt">Downloading v%1$s…</string>
    <string name="download_failed">The download failed.</string>
    <string name="update_ready_fmt">Version %1$s is downloaded and ready.</string>
    <string name="install_update">Install update</string>
    <string name="installing">Installing…</string>
    <!-- The button keeps offering itself while an install is in flight: a
         session can stall or its confirmation be dismissed, and then this tap
         is the only way out. -->
    <string name="install_retry">Install again</string>

    <string name="parent_sort">Change the order</string>
    <string name="parent_sort_last_added">Recently added</string>
    <string name="parent_sort_a_z">A–Z</string>
    <!-- The window that applied used to be named here ("Most watched · last 7
         days"), which was noise on the ordinary case. What still has to be said
         is the case below: "most watched" over an empty history quietly means
         A–Z, and a list that looks unsorted is indistinguishable from one that
         is broken. -->
    <string name="parent_sort_watched_days">Most watched</string>
    <string name="parent_sort_watched_none">Most watched · nothing watched yet, so A–Z</string>

    <string name="settings_title">Settings</string>
    <string name="settings_hold">Hold to unlock the player</string>
    <string name="settings_hold_explain">How long the corner of the player has to be held before YouTube\'s own controls become reachable. Longer is harder for a child to trigger by resting a thumb.</string>
    <plurals name="hold_seconds">
        <item quantity="one">%d second</item>
        <item quantity="other">%d seconds</item>
    </plurals>
    <string name="settings_next_video">When a video ends</string>
    <string name="settings_next_video_explain">Another video starts automatically. Choose which one.</string>
    <string name="settings_next_in_order">Play the next one down the list</string>
    <string name="settings_next_random">Play a random one</string>
    <!-- Says where "the list" is, because the answer depends on where the
         child tapped and that is not obvious from either label. -->
    <string name="settings_next_scope_explain">Either way it comes from whatever was on screen: everything, or just that channel if you opened one. Playing in order stops at the end of the list.</string>
</resources>
