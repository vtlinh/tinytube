<?xml version="1.0" encoding="utf-8"?>
<!-- Light palette. The app runs dark (see App.kt), so these are what you get
     by switching the one line there back to following the system — they are
     kept in step with values-night/colors.xml deliberately, not left to rot. -->
<resources>
    <color name="bg">#F1F7FC</color>
    <color name="surface">#FFFFFF</color>

    <!-- The dark palette's light blue is unreadable on white, so the light one
         takes the same hue much darker. -->
    <color name="accent">#0B6FB8</color>
    <color name="on_accent">#FFFFFF</color>

    <color name="text">#12212E</color>
    <!-- Hairlines between rows inside a card. Barely there on purpose: it is
         separating related things, not fencing them off. -->
    <color name="divider">#1A12212E</color>
    <color name="text_muted">#52657A</color>
    <color name="black">#000000</color>

    <!-- The player's hold-to-reveal corner. Green rather than the app's blue
         accent: it is the one thing drawn over a video, and it should not look
         like part of the app's furniture. Not duplicated in values-night —
         the player is always on black, in either palette. -->
    <color name="reveal_green">#00E06A</color>
    <color name="reveal_track">#3300E06A</color>
    <!-- The corner's glow. Was 0x22 alpha — 13% — back when it was a tint that
         sat there while a video played, where faint was the point. It is a
         one-second flash now and 13% green over moving footage is not something
         anyone sees, which is exactly how it came to look broken. Half opaque
         for the second it is up, and gone the rest of the time. -->
    <color name="reveal_glow">#7A00E06A</color>

    <!-- Sits behind a poster until it loads. Has to read as "empty tile"
         rather than as a broken image, in either palette. -->
    <color name="thumb_placeholder">#DCE6EF</color>
</resources>
