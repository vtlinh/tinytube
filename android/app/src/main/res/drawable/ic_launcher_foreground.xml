<?xml version="1.0" encoding="utf-8"?>
<!-- A smiling screen, replacing the play-triangle card: at launcher size a
     triangle-in-a-box reads as "a video app" and little else, while a face is
     recognisable to a child who can't read the label yet.

     Adaptive-icon foregrounds are 108dp with only the middle 72dp guaranteed
     visible, and the launcher may mask to a circle — everything here sits
     inside roughly a 60dp centred square so no part of the face can be
     clipped. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- the screen -->
    <path
        android:pathData="M32,34 L76,34 A9,9 0 0 1 85,43 L85,65 A9,9 0 0 1 76,74 L32,74 A9,9 0 0 1 23,65 L23,43 A9,9 0 0 1 32,34 Z"
        android:fillColor="#FFFFFF" />

    <!-- stand -->
    <path
        android:pathData="M46,74 L62,74 L62,80 L46,80 Z"
        android:fillColor="#FFFFFF" />

    <!-- eyes -->
    <path
        android:pathData="M39,48 m-4.5,0 a4.5,4.5 0 1,0 9,0 a4.5,4.5 0 1,0 -9,0 Z"
        android:fillColor="#0B4A73" />
    <path
        android:pathData="M69,48 m-4.5,0 a4.5,4.5 0 1,0 9,0 a4.5,4.5 0 1,0 -9,0 Z"
        android:fillColor="#0B4A73" />

    <!-- smile -->
    <path
        android:pathData="M42,59 Q54,68 66,59"
        android:strokeColor="#0B4A73"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

</vector>
