<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon is an adaptive icon: drawn into an ImageView it comes
     out as a full square, because the mask that rounds it belongs to the
     launcher rather than to the drawable. This is that mask, applied by
     clipToOutline — see activity_about. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/bg" />
    <corners android:radius="16dp" />
</shape>
