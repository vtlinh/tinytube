<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- Status bar. The Parent button is visible rather than hidden behind a
         long-press, because a parent has to be able to find it; what stops a
         child using it is the device lock behind it, not obscurity.
         Long-pressing the title still opens About.

         Kept short deliberately. It is a heading on a screen whose whole
         point is the posters below it, and every dp it takes is a dp of
         video tile — one row of a two-column grid is most of a phone.

         A FIXED height, not wrap_content, and the buttons have their minimums
         cleared. That is what actually governs it: borderlessButtonStyle
         carries a 48dp minHeight, so with wrap_content the bar was 48dp of
         button plus its padding however small the text was made. Trimming the
         padding did nothing visible, because the padding was never what was
         setting the height.

         44dp, and the buttons fill it — so the bar is shorter than a stock
         one while what a thumb can hit is the full height of it rather than
         the few dp the label occupies. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <!-- Only while one channel's videos are showing. An arrow at the start
             rather than a worded button at the end: narrowing the grid to a
             channel is a step into something, and every other app on the phone
             says a step back out is an arrow up here. The system back button
             does the same thing, so the two agree.

             The title takes over the start inset when this is hidden, which is
             nearly always — see MainActivity.render. -->
        <ImageButton
            android:id="@+id/back"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:src="@drawable/ic_back"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:contentDescription="@string/show_all_videos"
            android:visibility="gone" />

        <TextView
            android:id="@+id/header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="@string/app_name"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/text"
            android:maxLines="1"
            android:ellipsize="end" />

        <Button
            android:id="@+id/parent_mode"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/parent_mode"
            style="?android:attr/borderlessButtonStyle"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/accent"
            android:textSize="14sp" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="24dp"
            android:scrollbars="none" />

        <!-- The Channels tab. Read-only on purpose: this is the child's side
             of the app, and the approved list is the parental control. Tapping
             a row filters the grid to that channel; it cannot remove one and
             it cannot open YouTube. Both of those live behind the gate, in
             ApprovedChannelsActivity. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/channels"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp"
            android:scrollbars="none"
            android:visibility="gone" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/empty_catalog"
            android:textSize="20sp"
            android:textColor="@color/text_muted"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:padding="32dp"
            android:visibility="gone" />

    </FrameLayout>

    <include layout="@layout/bottom_tabs" />

</LinearLayout>
