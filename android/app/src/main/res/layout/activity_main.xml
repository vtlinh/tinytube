<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- Status bar. The Parent button is visible rather than hidden behind a
         long-press, because a parent has to be able to find it; what stops a
         child using it is the device lock behind it, not obscurity.
         Long-pressing the title still opens About.

         Kept short deliberately. It is a heading on a screen whose whole
         point is the posters below it, and every dp it takes is a dp of
         video tile — one row of a two-column grid is most of a phone. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface"
        android:paddingStart="20dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Only while one channel's videos are showing: the way back to all
             of them, and the label that says you are not looking at all of
             them. Gone the rest of the time, which is nearly always. -->
        <Button
            android:id="@+id/show_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/show_all_videos"
            style="?android:attr/borderlessButtonStyle"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/parent_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/parent_mode"
            style="?android:attr/borderlessButtonStyle"
            android:textColor="@color/accent"
            android:textSize="14sp" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="24dp"
            android:scrollbars="none" />

        <!-- The Channels tab. Read-only on purpose: this is the child's side
             of the app, and the approved list is the parental control. Tapping
             a row filters the grid to that channel; it cannot remove one and
             it cannot open YouTube. Both of those live behind the gate, in
             ApprovedChannelsActivity. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/channels"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp"
            android:scrollbars="none"
            android:visibility="gone" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/empty_catalog"
            android:textSize="20sp"
            android:textColor="@color/text_muted"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:padding="32dp"
            android:visibility="gone" />

    </FrameLayout>

    <include layout="@layout/bottom_tabs" />

</LinearLayout>
