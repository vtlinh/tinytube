<?xml version="1.0" encoding="utf-8"?>
<!-- One tile. Deliberately large: the whole card is the tap target, so an
     imprecise tap still lands on the video the child meant. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_margin="8dp"
    android:padding="8dp"
    android:background="@drawable/bg_tile"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <!-- Ratio-locked so the grid does not reflow as posters arrive; see
         RatioImageView. -->
    <dev.vtlinh.ytkids.RatioImageView
        android:id="@+id/thumb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E5E7EB"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:paddingBottom="4dp"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text"
        android:maxLines="2"
        android:ellipsize="end" />

</LinearLayout>
