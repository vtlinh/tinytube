<?xml version="1.0" encoding="utf-8"?>
<!-- The approved list, back as a screen of its own.

     It was folded into settings while it was only ever a flat list of rows.
     Groups gave it a selection mode, a two-state toolbar and a dialog, and
     none of that fits inside a scrolling settings page — a long-press that
     starts selecting inside a screen full of sliders is a trap. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        android:theme="@style/ThemeOverlay.TinyTube.Toolbar"
        android:popupTheme="@style/ThemeOverlay.TinyTube.Toolbar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="24dp" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/parent_none_approved"
            android:textSize="17sp"
            android:textColor="@color/text_muted"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:padding="32dp"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
