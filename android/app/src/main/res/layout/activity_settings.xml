<?xml version="1.0" encoding="utf-8"?>
<!-- Parent settings. Reached only through parent mode, which is itself behind
     ChallengeActivity, so nothing here needs a gate of its own.

     The bottom two cards used to be a screen of their own, reached by
     long-pressing the grid's title. That put a parent-facing screen on the
     child's side of the app and hid it behind a gesture nobody would guess;
     the settings are where an adult already is. Its "N approved channels" card
     went at the same time — the approved list is one tap away in the bar above
     this screen, and a count of it is not news.

     Cards on a plain background, so a setting reads as a thing you press
     rather than as a line of prose. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- What plays next. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_tile"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_next_video"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/settings_next_video_explain"
                android:textSize="14sp"
                android:textColor="@color/text_muted"
                android:lineSpacingExtra="2dp" />

            <!-- A radio group rather than a switch: there are two named
                 choices and neither is an "off". -->
            <RadioGroup
                android:id="@+id/next_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/next_in_order"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/settings_next_in_order"
                    android:textSize="16sp"
                    android:textColor="@color/text" />

                <RadioButton
                    android:id="@+id/next_random"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/settings_next_random"
                    android:textSize="16sp"
                    android:textColor="@color/text" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/settings_next_scope_explain"
                android:textSize="13sp"
                android:textColor="@color/text_muted"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <!-- How long the player's corner has to be held. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:background="@drawable/bg_tile"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_hold"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/settings_hold_explain"
                android:textSize="14sp"
                android:textColor="@color/text_muted"
                android:lineSpacingExtra="2dp" />

            <!-- The current value in words above the slider, because a bare
                 track says nothing about what it is counting. -->
            <TextView
                android:id="@+id/hold_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textSize="16sp"
                android:textColor="@color/accent" />

            <!-- max and progress are set from HoldTime; the values here are
                 only so the editor preview isn't a zero-width track. -->
            <SeekBar
                android:id="@+id/hold_slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="4"
                android:progress="0" />
        </LinearLayout>

        <!-- What this is. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_tile"
            android:padding="20dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="16dp"
                android:src="@mipmap/ic_launcher"
                android:background="@drawable/bg_app_icon"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text" />

                <TextView
                    android:id="@+id/version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="3dp"
                    android:textSize="14sp"
                    android:textColor="@color/text_muted" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="1dp"
                    android:text="@string/author"
                    android:textSize="14sp"
                    android:textColor="@color/text_muted" />

            </LinearLayout>

        </LinearLayout>

        <!-- Updates: the only part of this screen that reaches the network. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:background="@drawable/bg_tile"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_updates"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textAllCaps="true"
                android:textColor="@color/text_muted" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:textSize="16sp"
                android:lineSpacingMultiplier="1.15"
                android:textColor="@color/text" />

            <Button
                android:id="@+id/action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/accent"
                android:textColor="@color/on_accent" />

            <!-- Shown only when notifications can't appear. Without them an
                 update downloads and nothing says so, so the state is worth
                 surfacing on the one screen a parent actually reads.

                 Below the update control rather than above it: it explains a
                 limitation of the thing above it, and leading with it made a
                 working app look broken. -->
            <View
                android:id="@+id/notif_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="@color/divider"
                android:visibility="gone" />

            <TextView
                android:id="@+id/notif_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="16dp"
                android:textSize="14sp"
                android:textColor="@color/text_muted"
                android:lineSpacingMultiplier="1.2"
                android:visibility="gone" />

            <Button
                android:id="@+id/notif_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginStart="-8dp"
                style="?android:attr/borderlessButtonStyle"
                android:textColor="@color/accent"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
