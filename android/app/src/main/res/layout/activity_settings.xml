<?xml version="1.0" encoding="utf-8"?>
<!-- Parent settings. Reached only through parent mode, which is itself behind
     ChallengeActivity, so nothing here needs a gate of its own.

     The identity card at the top and the Updates card at the bottom used to be
     a screen of their own, reached by long-pressing the grid's title. That put
     a parent-facing screen on the child's side of the app and hid it behind a
     gesture nobody would guess; the settings are where an adult already is.
     They are at opposite ends on purpose. The identity leads because it is
     what this screen is a screen ABOUT; Updates trails because it is an
     action, and an action belongs under the things it acts on.

     THE APPROVED LIST IS NOT HERE. It was, for a build, as the list itself
     rather than a button — right while it was a flat column of rows. Groups
     gave it a selection mode, a toolbar that becomes "3 selected" and a
     dialog, and none of that can be a section inside a scrolling page: a
     long-press that starts selecting rows in among the sliders is a trap, and
     a heading cannot have two states. It is ApprovedChannelsActivity again,
     one tap away on the bar above this screen.

     Cards on a plain background, so a setting reads as a thing you press
     rather than as a line of prose. Their padding is deliberately tighter than
     it reads in a layout editor: five cards at 20dp each pushed the last of
     them off the bottom of a phone, and the space was doing nothing but
     separating things already separated by having a card each. The RadioButtons
     keep their 48dp minimum — that is a touch target, not decoration.

     EVERY EXPLANATION IS BEHIND THE ? BESIDE ITS HEADING. They used to sit
     under the headings in grey, permanently, and four of them was most of the
     screen — a parent scrolling for the hold slider read three paragraphs about
     things they already understood to reach it. The words are the same; they
     are just no longer in the way of the controls they describe. See
     Tooltip.kt. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- What this is. First, because it is what the screen is a screen
             ABOUT: a parent who opened settings to check the version should
             not have to read past two controls to find it, and a parent who
             opened it to change something loses nothing by scrolling past four
             lines that never move. Updates stay at the bottom — that card is
             an action, and actions belong under the things they act on. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_tile"
            android:padding="14dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="16dp"
                android:src="@mipmap/ic_launcher"
                android:background="@drawable/bg_app_icon"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text" />

                <TextView
                    android:id="@+id/version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="3dp"
                    android:textSize="14sp"
                    android:textColor="@color/text_muted" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="1dp"
                    android:text="@string/author"
                    android:textSize="14sp"
                    android:textColor="@color/text_muted" />

            </LinearLayout>

        </LinearLayout>

        <!-- What plays next. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:background="@drawable/bg_tile"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_next_video"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text" />

                <ImageButton
                    android:id="@+id/help_next_video"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="2dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_help"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:scaleType="fitCenter" />
            </LinearLayout>

            <!-- A radio group rather than a switch: there are two named
                 choices and neither is an "off". -->
            <RadioGroup
                android:id="@+id/next_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/next_in_order"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/settings_next_in_order"
                    android:textSize="16sp"
                    android:textColor="@color/text" />

                <RadioButton
                    android:id="@+id/next_random"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/settings_next_random"
                    android:textSize="16sp"
                    android:textColor="@color/text" />
            </RadioGroup>

        </LinearLayout>

        <!-- How long the player's corner has to be held. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:background="@drawable/bg_tile"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_hold"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text" />

                <ImageButton
                    android:id="@+id/help_hold"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="2dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_help"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:scaleType="fitCenter" />
            </LinearLayout>

            <!-- The current value in words above the slider, because a bare
                 track says nothing about what it is counting. -->
            <TextView
                android:id="@+id/hold_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="16sp"
                android:textColor="@color/accent" />

            <!-- max and progress are set from HoldTime; the values here are
                 only so the editor preview isn't a zero-width track. -->
            <SeekBar
                android:id="@+id/hold_slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="4"
                android:progress="0" />
        </LinearLayout>

        <!-- Updates: the only part of this screen that reaches the network. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:background="@drawable/bg_tile"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_updates"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:textAllCaps="true"
                    android:textColor="@color/text_muted" />

                <ImageButton
                    android:id="@+id/help_updates"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="2dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_help"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:scaleType="fitCenter" />
            </LinearLayout>

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:textSize="16sp"
                android:lineSpacingMultiplier="1.15"
                android:textColor="@color/text" />

            <Button
                android:id="@+id/action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:backgroundTint="@color/accent"
                android:textColor="@color/on_accent" />

            <!-- Shown only when notifications can't appear. Without them an
                 update downloads and nothing says so, so the state is worth
                 surfacing on the one screen a parent actually reads.

                 Below the update control rather than above it: it explains a
                 limitation of the thing above it, and leading with it made a
                 working app look broken. -->
            <View
                android:id="@+id/notif_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:background="@color/divider"
                android:visibility="gone" />

            <TextView
                android:id="@+id/notif_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="16dp"
                android:textSize="14sp"
                android:textColor="@color/text_muted"
                android:lineSpacingMultiplier="1.2"
                android:visibility="gone" />

            <Button
                android:id="@+id/notif_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginStart="-8dp"
                style="?android:attr/borderlessButtonStyle"
                android:textColor="@color/accent"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
