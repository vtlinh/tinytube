<?xml version="1.0" encoding="utf-8"?>
<!-- Wrapped so the bottom bar can sit under the scrolling content rather than
     scroll away with it: About is short, but the bar is the app's navigation
     and a control that comes and goes is not navigation. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text" />

        <TextView
            android:id="@+id/version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:textSize="15sp"
            android:textColor="@color/text_muted" />

        <TextView
            android:id="@+id/catalog_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:textSize="15sp"
            android:textColor="@color/text_muted" />

        <TextView
            android:id="@+id/author"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:text="@string/author"
            android:textSize="15sp"
            android:textColor="@color/text_muted" />

        <!-- Shown only when notifications can't appear. Without them an update
             downloads and nothing says so, so the state is worth surfacing on
             the one screen a parent actually reads. -->
        <TextView
            android:id="@+id/notif_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="28dp"
            android:textSize="15sp"
            android:textColor="@color/text_muted"
            android:lineSpacingMultiplier="1.2"
            android:visibility="gone" />

        <Button
            android:id="@+id/notif_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            style="?android:attr/borderlessButtonStyle"
            android:textColor="@color/accent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="28dp"
            android:textSize="16sp"
            android:textColor="@color/text" />

        <Button
            android:id="@+id/action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/accent"
            android:textColor="@color/on_accent" />

    </LinearLayout>

</ScrollView>

    <include layout="@layout/bottom_tabs" />

</LinearLayout>
