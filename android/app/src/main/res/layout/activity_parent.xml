<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- The parent-mode status bar: get out, approve what you're looking at,
         review what you've approved. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <Button
            android:id="@+id/kids_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/kids_mode"
            style="?android:attr/borderlessButtonStyle"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/approved"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_approved_list"
            android:tint="@color/text_muted"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:contentDescription="@string/parent_approved_button" />

        <!-- Only enabled on an actual channel page; see
             YouTubeUrls.isChannelPage and ParentActivity.updateApproveButton. -->
        <ImageButton
            android:id="@+id/add_channel"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_approve_channel"
            android:tint="@color/accent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:contentDescription="@string/parent_add_channel" />

    </LinearLayout>

    <!-- Reports something that just happened — approved, removed, couldn't
         work out the channel — and disappears on the next navigation. Hidden
         otherwise: a browser doesn't need a caption, and a permanent hint
         would just be a strip of text above every page. -->
    <TextView
        android:id="@+id/current"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:textSize="13sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/text_muted"
        android:visibility="gone" />

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
