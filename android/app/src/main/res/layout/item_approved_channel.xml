<?xml version="1.0" encoding="utf-8"?>
<!-- Tapping the row opens the channel; the X removes it. The two targets are
     kept well apart so a thumb aiming for one doesn't hit the other.

     BACKGROUND AND FOREGROUND BOTH, and each is doing a different job. The
     background carries the ACTIVATED state — that is what a selected row looks
     like in the parent's list — and the foreground keeps the ripple, which the
     activated selector has none of. One attribute cannot be both: putting the
     ripple in the background would leave a selected row indistinguishable from
     an unselected one, which on a screen whose whole point is picking rows is
     the difference between working and not. The child's Channels tab inflates
     this too and never activates anything, so it looks exactly as it did. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?android:attr/activatedBackgroundIndicator"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="20dp"
    android:paddingEnd="8dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- clipToOutline against an oval background is what makes this round
         without pulling in an image library for one shape. -->
    <ImageView
        android:id="@+id/avatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_avatar"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            android:textColor="@color/text"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:textSize="13sp"
            android:textColor="@color/text_muted"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/remove"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_close"
        android:tint="@color/text_muted"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:scaleType="centerInside" />

</LinearLayout>
