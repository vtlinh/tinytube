<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black" />

    <!-- Above the WebView, and native rather than part of the page: a view in
         this hierarchy is unambiguously on top and cannot be reached by
         anything the page does. It takes every touch, so YouTube's own surface
         — including end-screen cards over the last stretch of a video — cannot
         be tapped. Transparent, so nothing is hidden.

         It carries no controls of its own. A video plays; that is the whole
         interaction. The only thing on it is the corner below, and the only
         thing that does is hand the player back to an adult.

         It stops intercepting while an ad is playing; see PlayerActivity. -->
    <FrameLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true">

        <!-- Covers the player while it is PAUSED, and only then.

             A paused embed draws its title, the channel and "Watch on YouTube"
             across the frame, and no player parameter turns that off —
             showinfo=0 was removed in 2018 and modestbranding=1 became a no-op
             in 2023. The overlay already makes it untappable; this makes the
             paused frame ours rather than an advertisement for elsewhere.

             Deliberately only while paused: nothing is hidden during playback,
             and the overlay stands down entirely during ads. -->
        <View
            android:id="@+id/paused_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#E6000000"
            android:visibility="gone" />

        <!-- Hold this for three seconds to lift the overlay and reach
             YouTube's real controls.

             The tint is normally invisible and appears on a tap anywhere on
             the overlay, then fades again a few seconds later — so the picture
             is unobstructed while a video is actually being watched, and a
             parent who needs the corner can summon it by tapping the screen
             like anyone would. The corner itself is live the whole time,
             tinted or not: the tint is a label, not a switch.

             136dp square, twice the area it started at, because the target is
             invisible most of the time and a thumb aiming at nothing needs the
             room.

             Three seconds, not Android's half-second long-press — that is
             short enough for a resting thumb to trigger. The ring inside fills
             over those three seconds so the hold is visibly a hold rather than
             a tap that did nothing.

             alpha starts at 0; PlayerActivity owns it from there. -->
        <FrameLayout
            android:id="@+id/reveal_corner"
            android:layout_width="136dp"
            android:layout_height="136dp"
            android:layout_gravity="top|end"
            android:alpha="0"
            android:background="@drawable/bg_reveal_corner">

            <ProgressBar
                android:id="@+id/reveal_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:progressDrawable="@drawable/reveal_progress"
                android:max="1000"
                android:progress="0"
                android:visibility="invisible" />

        </FrameLayout>

    </FrameLayout>

</FrameLayout>
