<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black" />

    <!-- Above the WebView, and native rather than part of the page: a view in
         this hierarchy is unambiguously on top and cannot be reached by
         anything the page does. It takes every touch, so YouTube's own surface
         — including end-screen cards over the last stretch of a video — cannot
         be tapped. Transparent, so nothing is hidden.

         It stops intercepting while an ad is playing; see PlayerActivity. -->
    <FrameLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true">

        <!-- Covers the player while it is PAUSED, and only then.

             controls: 0 removes YouTube's control bar but not the title and
             "Watch on YouTube" chrome, which appears whenever the player is
             paused. showinfo=0 used to hide it and was removed in 2018;
             modestbranding=1 became a no-op in 2023. There is no parameter
             left that turns it off, so the paused frame is covered instead.

             Deliberately only while paused: nothing is hidden during playback,
             and the overlay stands down entirely during ads. -->
        <View
            android:id="@+id/paused_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#E6000000"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/play_pause"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_pause"
            android:background="@drawable/bg_player_button"
            android:scaleType="centerInside"
            android:contentDescription="@string/player_pause" />

    </FrameLayout>

</FrameLayout>
