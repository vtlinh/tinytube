<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black" />

    <!-- Above the WebView, and native rather than part of the page: a view in
         this hierarchy is unambiguously on top and cannot be reached by
         anything the page does. It takes every touch, so YouTube's own surface
         — including end-screen cards over the last stretch of a video — cannot
         be tapped. Transparent, so nothing is hidden.

         It carries no controls of its own. A video plays; that is the whole
         interaction. The only thing on it is the corner below, and the only
         thing that does is hand the player back to an adult.

         It stops intercepting while an ad is playing; see PlayerActivity. -->
    <FrameLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true">

        <!-- Covers the player while it is PAUSED, and only then.

             A paused embed draws its title, the channel and "Watch on YouTube"
             across the frame, and no player parameter turns that off —
             showinfo=0 was removed in 2018 and modestbranding=1 became a no-op
             in 2023. The overlay already makes it untappable; this makes the
             paused frame ours rather than an advertisement for elsewhere.

             Deliberately only while paused: nothing is hidden during playback,
             and the overlay stands down entirely during ads. -->
        <View
            android:id="@+id/paused_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#E6000000"
            android:visibility="gone" />

        <!-- Hold this to lift the overlay and reach YouTube's real controls.

             Normally invisible. It GLOWS for a second whenever the overlay
             comes back — at the start of a video, and after a reveal ends —
             and is invisible the rest of the time. That replaces a tint that
             appeared on a tap anywhere and faded a second later, which had the
             corner drawn over the picture at the moment a child was most
             likely to be touching the screen. Announcing itself once, when the
             thing it belongs to appears, says the same thing at a moment
             nobody is watching anything yet.

             The corner is live the whole time, glowing or not: the glow is a
             label, not a switch.

             136dp square, twice the area it started at, because the target is
             invisible most of the time and a thumb aiming at nothing needs the
             room.

             alpha starts at 0; PlayerActivity owns it from there. -->
        <View
            android:id="@+id/reveal_corner"
            android:layout_width="136dp"
            android:layout_height="136dp"
            android:layout_gravity="top|end"
            android:alpha="0"
            android:background="@drawable/bg_reveal_corner" />

        <!-- The countdown, filling over the two seconds of the hold so that a
             hold looks like a hold rather than a tap that did nothing.

             A sibling of the tint rather than a child of it, and that is the
             point: alpha applies to a whole subtree, so a ring inside the tint
             was invisible exactly when the tint was — which is most of the
             time, and includes every hold that starts without a tap first.
             Feedback for a press must not depend on whether a hint happens to
             be showing.

             Positioned by margin to land in the middle of the 136dp corner:
             (136 - 44) / 2. Not clickable, so touches fall straight through to
             the corner underneath it.

             Two seconds, not Android's half-second long-press — that is short
             enough for a resting thumb to trigger. -->
        <ProgressBar
            android:id="@+id/reveal_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="46dp"
            android:layout_marginEnd="46dp"
            android:progressDrawable="@drawable/reveal_progress"
            android:max="1000"
            android:progress="0"
            android:visibility="invisible" />

    </FrameLayout>

    <!-- Blocked always, including while the overlay is lifted — which is why
         it is a sibling of the overlay rather than a child of it. Lifting the
         overlay hands YouTube's controls to an adult; it does not hand over
         the band underneath them.

         The height here is only where it starts: PlayerActivity measures the
         real inset off the player's own pixels and replaces it. See dimens.

         Invisible always. It was tinted for a while, which is how the
         measurement was checked by eye; now that the strip lands where it
         should, a coloured band across the bottom of every video is just
         something drawn over the video. -->
    <View
        android:id="@+id/bottom_blocker"
        android:layout_width="match_parent"
        android:layout_height="@dimen/player_bottom_block"
        android:layout_gravity="bottom"
        android:clickable="true"
        android:focusable="false" />

    <!-- The way out, and ONLY while the overlay is lifted.
         PlayerActivity ties its visibility to `revealed`.

         Back already worked here — the system button finishes the activity —
         but nothing on screen said so, and on iOS there is no system button at
         all. So both platforms get the same visible control, appearing at the
         same moment: it is an adult's control, and it arrives with the rest of
         them rather than sitting over every video a child watches.

         A sibling of the overlay, like the blocker, so it is not hidden by the
         thing whose absence reveals it. Top-left, clear of the reveal corner
         at top-right. -->
    <ImageButton
        android:id="@+id/player_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:background="@drawable/bg_player_back"
        android:contentDescription="@string/player_back"
        android:padding="10dp"
        android:src="@drawable/ic_player_back"
        android:visibility="gone" />

</FrameLayout>
