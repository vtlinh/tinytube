<?xml version="1.0" encoding="utf-8"?>
<!-- A group's header. Always expanded — its channels are drawn beneath it as
     ordinary rows — so this has no chevron and a plain tap does nothing. What
     it does have is a LONG press, which starts selection mode and takes every
     channel in the group with it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?android:attr/activatedBackgroundIndicator"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="6dp">

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="10dp"
        android:src="@drawable/ic_group"
        android:tint="@color/text_muted"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/group_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/text"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/group_size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/text_muted" />

</LinearLayout>
