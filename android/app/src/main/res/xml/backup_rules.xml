<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- The catalog cache is re-fetched on first launch and the update markers
         describe an APK that lives in cacheDir, which is never backed up.
         Restoring either onto a new device would only produce state that
         disagrees with what is actually there. -->
    <exclude domain="file" path="catalog.json" />
    <exclude domain="sharedpref" path="app.xml" />
    <!-- The player's last measured strip. A diagnostic image of part of a
         video someone was watching has no business travelling to a cloud
         backup or onto another device. -->
    <exclude domain="file" path="capture" />
</full-backup-content>
