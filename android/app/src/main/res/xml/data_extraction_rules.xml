<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="catalog.json" />
        <exclude domain="sharedpref" path="app.xml" />
        <!-- See backup_rules.xml: the player's diagnostic capture stays on
             the device it was taken on. -->
        <exclude domain="file" path="capture" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="catalog.json" />
        <exclude domain="sharedpref" path="app.xml" />
        <exclude domain="file" path="capture" />
    </device-transfer>
</data-extraction-rules>
