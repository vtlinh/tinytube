<?xml version="1.0" encoding="utf-8"?>
<!-- Dark palette — what the app actually runs with.

     Kept warm rather than neutral grey so it stays the same app as the light
     one, and so it sits next to the player's pure black without the grid
     looking like a different product.

     Not pure black for the surfaces: on OLED that makes the tiles float with
     no edges, and the scroll has nothing to read against. The player is black
     because a video should have nothing around it; the grid is not. -->
<resources>
    <color name="bg">#16120F</color>
    <color name="surface">#241D18</color>

    <!-- Lifted well off the light accent (#E8590C). That orange on a dark
         background is muddy and fails contrast against it; this one carries. -->
    <color name="accent">#FF8A4C</color>
    <!-- Dark ink on the light accent — white on #FF8A4C is unreadable. -->
    <color name="on_accent">#2A1405</color>

    <color name="text">#F4EFEA</color>
    <color name="text_muted">#B5AAA0</color>
    <color name="black">#000000</color>

    <color name="thumb_placeholder">#2E2721</color>
</resources>
