<?xml version="1.0" encoding="utf-8"?>
<!-- Dark palette — what the app actually runs with.

     Cool blues rather than a neutral grey, so it stays a deliberate colour
     scheme next to the player's pure black rather than looking like an absence
     of one.

     Not pure black for the surfaces: on OLED that makes the tiles float with
     no edges, and the scroll has nothing to read against. The player is black
     because a video should have nothing around it; the grid is not. -->
<resources>
    <color name="bg">#0E1621</color>
    <color name="surface">#182534</color>

    <!-- Light blue, lifted well clear of the background. A mid blue reads as
         muddy down here and fails contrast against it. -->
    <color name="accent">#7CC4FF</color>
    <!-- Dark ink on the light accent — white on #7CC4FF is unreadable. -->
    <color name="on_accent">#062033</color>

    <color name="text">#E9F1F8</color>
    <!-- See values/colors.xml. Lighter than the surface rather than darker:
         down here a darker line reads as a gap in the card. -->
    <color name="divider">#24E9F1F8</color>
    <color name="text_muted">#9DB0C4</color>
    <color name="black">#000000</color>

    <color name="thumb_placeholder">#21313F</color>
</resources>
